# Local mode: SQLite + local disk + goroutine MQ
# Usage: podman-compose --env-file .env.local up -d

# Database
DB_DRIVER=sqlite
SQLITE_PATH=/app/data/cloud.db

# Storage
STORAGE_MODE=local
PRIMARY_MAX_BYTES=10737418240

# Kafka not used (goroutine MQ auto-activates when brokers empty)
KAFKA_BROKERS=

# SeaweedFS not used
SEAWEEDFS_ENDPOINT=

# JWT
JWT_SECRET=change-me-in-production

# Optional: OSS for cold storage fallback
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=light-cloud-disk
# OSS_REGION=cn-hangzhou
