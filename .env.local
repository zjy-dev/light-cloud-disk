# Local development mode: SQLite + local disk + goroutine MQ
# Usage: podman-compose --env-file .env.local up -d

# Database
DB_DRIVER=sqlite
SQLITE_PATH=/app/data/cloud.db

# Storage
PRIMARY_MAX_BYTES=10737418240

# Erasure coding
ERASURE_DATA_SHARDS=4
ERASURE_PARITY_SHARDS=2
ERASURE_MIN_FILE_SIZE=1048576

# JWT
JWT_SECRET=change-me-in-production

# Optional: OSS for cold storage fallback
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=light-cloud-disk
# OSS_REGION=cn-hangzhou
