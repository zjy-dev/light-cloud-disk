# S3 mode: MySQL + SeaweedFS + Kafka + file-worker
# Usage: podman-compose --env-file .env.s3 --profile s3 up -d

# Database
DB_DRIVER=mysql
DB_PASSWORD=root123
DB_NAME=cloud_disk

# Storage
STORAGE_MODE=s3
PRIMARY_MAX_BYTES=53687091200

# Kafka
KAFKA_BROKERS=kafka:9092

# SeaweedFS
SEAWEEDFS_ENDPOINT=http://seaweedfs:8333
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=

# JWT
JWT_SECRET=change-me-in-production

# Optional: OSS for cold storage eviction
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=light-cloud-disk
# OSS_REGION=cn-hangzhou
