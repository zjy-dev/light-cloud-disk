# Database (driver: "mysql" or "sqlite")
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=cloud_disk
# SQLite file path (only used when DB_DRIVER=sqlite)
SQLITE_PATH=./data.db

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Service discovery
CONSUL_ADDR=localhost:8500

# Auth
JWT_SECRET=replace-with-strong-random-secret

# Gateway
GATEWAY_ADDR=:8080

# File storage runtime paths (local/container)
FILE_TMP_DIR=/tmp/light-cloud-disk/chunks
FILE_STORE_DIR=/tmp/light-cloud-disk/store

# Primary storage capacity (bytes)
PRIMARY_MAX_BYTES=10737418240

# Erasure coding (Reed-Solomon)
ERASURE_DATA_SHARDS=4
ERASURE_PARITY_SHARDS=2
ERASURE_MIN_FILE_SIZE=1048576

# Kafka (leave empty to use in-process goroutine MQ as fallback)
KAFKA_BROKERS=localhost:9092

# File service HTTP endpoint (for direct chunk upload/download)
FILE_HTTP_ADDR=:9003

# Alibaba Cloud OSS (cold storage / fallback)
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=cn-hangzhou
OSS_BUCKET=light-cloud-disk

# Build/deploy
VERSION=dev
