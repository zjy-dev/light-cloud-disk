# Database (driver: "mysql" or "sqlite")
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=cloud_disk
# SQLite file path (only used when DB_DRIVER=sqlite)
SQLITE_PATH=./data.db

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Service discovery
CONSUL_ADDR=localhost:8500

# Auth
JWT_SECRET=replace-with-strong-random-secret

# Gateway
GATEWAY_ADDR=:8080

# File storage runtime paths (local/container)
FILE_TMP_DIR=/tmp/light-cloud-disk/chunks
FILE_STORE_DIR=/tmp/light-cloud-disk/store

# Storage mode: "local" (single-server, local disk) or "s3" (SeaweedFS cluster)
STORAGE_MODE=local
# Primary storage capacity (bytes). Applies to local disk or SeaweedFS depending on mode
PRIMARY_MAX_BYTES=10737418240

# SeaweedFS (S3-compatible object storage, only needed in s3 mode)
SEAWEEDFS_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=
SEAWEEDFS_BUCKET=light-cloud-disk

# Alibaba Cloud OSS (cold storage / fallback)
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=cn-hangzhou
OSS_BUCKET=light-cloud-disk

# Kafka message queue (optional, goroutine MQ used when empty)
KAFKA_BROKERS=localhost:9092
KAFKA_CLOUD_MIGRATE_TOPIC=cloud-migrate
KAFKA_THUMBNAIL_TOPIC=file-thumbnail

# Build/deploy
VERSION=dev
