# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=cloud_disk

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Service discovery
CONSUL_ADDR=localhost:8500

# Auth
JWT_SECRET=replace-with-strong-random-secret

# Gateway
GATEWAY_ADDR=:8080

# File storage runtime paths (local/container)
FILE_TMP_DIR=/tmp/light-cloud-disk/chunks
FILE_STORE_DIR=/tmp/light-cloud-disk/store
DOWNLOAD_URL_PREFIX=

# Optional object storage
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=

# Optional message queue
KAFKA_BROKERS=localhost:9092

# Build/deploy
VERSION=dev
